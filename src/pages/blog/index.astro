---
import Base from '@/layouts/Base.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import BlogCard from '@/components/BlogCard.astro';
import { getPublishedPosts } from '@/lib/blog';

const posts = await getPublishedPosts();
---

<Base
  title="Blog"
  description="Transmission log — written broadcasts on community, building in public, and creating at the edge of technology."
  canonicalPath="/blog"
>
  <div class="mx-auto max-w-4xl px-4 py-20">
    <div class="reveal">
      <SectionHeading title="Transmission Log" eyebrow="Written Broadcasts" marker="■" accent="magenta" as="h1">
        <a
          slot="aside"
          href="/rss.xml"
          class="link-underline font-mono text-xs uppercase tracking-widest"
        >
          RSS feed ↗
        </a>
      </SectionHeading>
      <div class="space-y-6">
        {posts.map((post) => <BlogCard post={post} />)}
      </div>
    </div>
  </div>
</Base>
