---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { SITE } from '@/site.config';

const hosts = (await getCollection('hosts')).sort((a, b) => a.data.order - b.data.order);

// Load optimizable host images from src/assets (eager → ImageMetadata available at build)
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/*.{jpg,jpeg,png,webp}', {
  eager: true,
});

const solutions = [
  {
    title: 'Share what we learn',
    body: 'Knowledge stops being locked to a few and starts flowing between many. A meetup, a group chat, a shared repo — community changes everything.',
  },
  {
    title: 'Treat the journey as experiments',
    body: 'Not a single test we can fail once. Every attempt is practice. We ship small things, learn in public, and keep iterating.',
  },
  {
    title: 'Ask for guidance',
    body: 'More than feels comfortable. Send the email. Write the message. The worst answer is silence; the best outcome is a shift in trajectory.',
  },
  {
    title: 'Document the journey',
    body: 'Build in public. Show the work, not just the launch. Someone behind you will find your small step huge.',
  },
  {
    title: 'Build a rhythm, not a rush',
    body: 'Ten consistent steps beat one giant leap that never happens. Daily progress compounds into breakthrough results.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Iskanmagar',
  url: `${SITE.url}/about`,
  description: SITE.description,
};
---

<Base
  title="About"
  description="The Iskanmagar manifesto — a broadcast for builders from underrepresented, multilingual communities, and the people behind the signal."
  canonicalPath="/about"
  jsonLd={jsonLd}
>
  <!-- Header -->
  <section class="border-b border-ink-line px-4 py-20 text-center">
    <h1 class="font-heading text-4xl font-bold text-white sm:text-6xl">
      <span class="text-signal">▌</span> About Iskanmagar
    </h1>
    <p class="eyebrow mt-4 justify-center">Broadcast from the edge</p>
  </section>

  <!-- Manifesto -->
  <section class="border-b border-ink-line bg-ink-soft/60 px-4 py-20">
    <div class="mx-auto max-w-3xl">
      <SectionHeading title="The Manifesto" marker="►" accent="magenta" />
      <div class="space-y-6 text-base leading-relaxed text-gray-300">
        <p class="text-lg font-semibold text-white">Where we start is not where we are meant to stop.</p>
        <p>
          Iskanmagar is a broadcast for those who grew up far from the center, but close to
          possibility. For multilingual kids who learned to switch languages before they learned to
          switch tabs. For builders from underrepresented places who know that
          <span class="font-semibold text-magenta-bright">talent is everywhere</span>, even when
          opportunity is not.
        </p>
        <blockquote class="border-l-4 border-signal bg-signal/5 py-2 pl-6 italic text-signal-bright">
          "In places the maps label as 'underrepresented,' we know them as home. Streets where
          accents are heavy, passports are weak, and yet the dreams are louder than any border."
        </blockquote>
        <p>
          This space exists to prove that a weak signal can still reach new skies. We share stories
          of people who turn <span class="text-magenta-bright">scarcity into creativity</span>,
          community into infrastructure, and late-night experiments into real-world transmissions.
        </p>

        <h3 class="pt-6 font-heading text-2xl font-bold text-white">Our solutions</h3>
        <div class="grid gap-4">
          {
            solutions.map((s) => (
              <div class="panel ticks p-5">
                <h4 class="mb-2 font-mono text-sm font-bold text-signal">→ {s.title}</h4>
                <p class="text-sm text-gray-300">{s.body}</p>
              </div>
            ))
          }
        </div>

        <div class="mt-8 border-2 border-magenta/60 bg-gradient-to-r from-magenta/10 to-signal/10 p-8">
          <p class="mb-3 font-mono text-lg font-bold text-magenta-bright">iskanmagar init .</p>
          <p>
            The broadcast is a reminder:
            <span class="font-semibold text-white"> we are here, we are building, and we are not done.</span>
          </p>
          <p class="mt-4 text-signal-bright">
            This is not just our beginning. It is an invitation to everyone who recognizes this
            reality — who juggles languages and expectations, who watches conferences at 2 a.m., who
            builds with second-hand tools but first-class ambition.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Hosts -->
  <section class="px-4 py-20">
    <div class="mx-auto max-w-6xl">
      <SectionHeading title="The Hosts" eyebrow="Transmission Operators" marker="►" />
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          hosts.map((host) => {
            const imgKey = `/src/assets/${host.data.image}`;
            const mod = host.data.image && images[imgKey] ? images[imgKey] : null;
            return (
              <article class="panel panel-hover group overflow-hidden">
                {mod && (
                  <div class="relative h-72 overflow-hidden">
                    <Image
                      src={mod.default}
                      alt={host.data.name}
                      widths={[320, 480, 640]}
                      sizes="(min-width: 1024px) 360px, (min-width: 768px) 45vw, 90vw"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/60 to-transparent" />
                    <div class="chyron absolute bottom-5 left-5 right-5">
                      <h3 class="chyron-name text-2xl">{host.data.name}</h3>
                      <p class="chyron-role">{host.data.title}</p>
                    </div>
                  </div>
                )}
                <div class="p-6">
                  {!mod && (
                    <div class="chyron mb-4">
                      <h3 class="chyron-name text-2xl">{host.data.name}</h3>
                      <p class="chyron-role">{host.data.title}</p>
                    </div>
                  )}
                  <p class="mb-4 font-mono text-xs text-gray-500">{host.data.role}</p>
                  <p class="text-sm leading-relaxed text-gray-300">{host.data.bio}</p>
                  {host.data.more && (
                    <details class="group/d mt-3">
                      <summary class="cursor-pointer list-none font-mono text-xs text-signal hover:text-signal-bright">
                        <span class="group-open/d:hidden">► Show more</span>
                        <span class="hidden group-open/d:inline">▼ Show less</span>
                      </summary>
                      <p class="mt-3 text-sm leading-relaxed text-signal-bright/90">{host.data.more}</p>
                    </details>
                  )}
                  {host.data.tags.length > 0 && (
                    <div class="mt-4 flex flex-wrap gap-2">
                      {host.data.tags.map((tag) => (
                        <span class="border border-signal/40 px-2 py-1 font-mono text-[10px] tracking-wide text-signal">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                  <div class="mt-4 flex items-center gap-4 border-t border-ink-line pt-4 font-mono text-xs">
                    {host.data.website && (
                      <a href={host.data.website} target="_blank" rel="noreferrer" class="link-underline">
                        Website ↗
                      </a>
                    )}
                    {host.data.twitter && (
                      <a href={host.data.twitter} target="_blank" rel="noreferrer" class="text-gray-500 hover:text-white" aria-label={`${host.data.name} on X`}>
                        𝕏
                      </a>
                    )}
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
</Base>
