---
import Base from '@/layouts/Base.astro';
---

<Base title="Signal Lost — 404" description="This transmission could not be found." noindex>
  <section class="mx-auto flex min-h-[75vh] max-w-3xl flex-col items-center justify-center px-4 py-16">
    <div class="monitor w-full">
      <div class="monitor-label">
        <span>Mon ·· · No signal</span>
        <span class="flex items-center gap-1.5 text-amber">
          <span class="h-1.5 w-1.5 animate-blink rounded-full bg-amber"></span> Off air
        </span>
      </div>
      <div class="monitor-screen crt-on mt-1.5">
        <!-- dead-channel static -->
        <div class="pointer-events-none absolute inset-0 animate-grain bg-grain opacity-25" aria-hidden="true"></div>
        <div class="pointer-events-none absolute inset-0 bg-scanlines opacity-40" aria-hidden="true"></div>
        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(115%_115%_at_50%_45%,transparent_60%,rgba(0,0,0,0.5)_100%)]"
          aria-hidden="true"
        >
        </div>

        <div class="relative z-10 flex flex-col items-center px-6 py-20 text-center sm:py-24">
          <p class="text-crt font-display text-5xl text-signal sm:text-7xl" aria-hidden="true">404</p>
          <h1 class="mt-8 font-heading text-3xl font-bold text-white sm:text-4xl">Signal lost</h1>
          <p class="mt-4 font-mono text-xs tracking-signal text-gray-400 sm:text-sm">
            THIS TRANSMISSION IS OFF AIR
          </p>
          <div class="mt-10 flex flex-col gap-4 sm:flex-row">
            <a href="/" class="btn-signal">▶ Back to broadcast</a>
            <a href="/episodes" class="btn-ghost">Browse episodes</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
