---
import Base from '@/layouts/Base.astro';
---

<Base title="Signal Lost — 404" description="This transmission could not be found." noindex>
  <section class="mx-auto flex min-h-[70vh] max-w-2xl flex-col items-center justify-center px-4 text-center">
    <p class="font-display text-5xl text-signal sm:text-7xl">404</p>
    <h1 class="mt-8 font-heading text-3xl font-bold text-white sm:text-4xl">Signal lost</h1>
    <p class="mt-4 font-mono text-sm tracking-widest text-gray-400">
      [ THE TRANSMISSION YOU'RE LOOKING FOR IS OFF AIR ]
    </p>
    <div class="mt-10 flex flex-col gap-4 sm:flex-row">
      <a href="/" class="btn-signal">▶ Back to broadcast</a>
      <a href="/episodes" class="btn-ghost">Browse episodes</a>
    </div>
  </section>
</Base>
