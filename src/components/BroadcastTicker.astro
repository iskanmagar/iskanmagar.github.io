---
/**
 * Horizontally scrolling broadcast ticker. Decorative (aria-hidden) — every
 * message it carries also exists as real page content elsewhere.
 */
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<div class="overflow-hidden border-y border-ink-line bg-ink-soft/70" aria-hidden="true">
  <div class="flex w-max animate-ticker py-3 font-mono text-[11px] tracking-[0.3em] text-gray-500">
    <!-- Two copies of the run so the -50% translate loops seamlessly -->
    {
      [0, 1].map(() => (
        <div class="flex shrink-0 items-center">
          {items.map((item) => (
            <>
              <span class="whitespace-nowrap px-7">{item}</span>
              <span class="h-1.5 w-1.5 shrink-0 bg-signal/60" />
            </>
          ))}
        </div>
      ))
    }
  </div>
</div>
