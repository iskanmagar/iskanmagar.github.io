---
interface Props {
  title: string;
  eyebrow?: string;
  marker?: string;
  accent?: 'signal' | 'magenta';
  as?: 'h1' | 'h2';
}
const { title, eyebrow, marker = '▶', accent = 'signal', as = 'h2' } = Astro.props;
const Tag = as;
const markerClass = accent === 'magenta' ? 'text-magenta' : 'text-signal';
---

<div class="mb-10">
  <Tag class="flex items-center gap-3 font-heading text-3xl font-bold text-white sm:text-4xl">
    <span class={markerClass} aria-hidden="true">{marker}</span>
    {title}
  </Tag>
  {eyebrow && <p class="eyebrow mt-3">[ {eyebrow} ]</p>}
</div>
