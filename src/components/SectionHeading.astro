---
interface Props {
  title: string;
  eyebrow?: string;
  marker?: string;
  accent?: 'signal' | 'magenta';
  as?: 'h1' | 'h2';
}
const { title, eyebrow, marker = '▶', accent = 'signal', as = 'h2' } = Astro.props;
const Tag = as;
const markerClass = accent === 'magenta' ? 'text-magenta' : 'text-signal';
---

<div class="mb-10">
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <Tag class="flex items-center gap-3 font-heading text-3xl font-bold tracking-tight text-white sm:text-4xl">
    <span class={markerClass} aria-hidden="true">{marker}</span>
    {title}
  </Tag>
  <div class="mt-4 flex items-center gap-3">
    <span class="bar-divider max-w-[140px]"></span>
    <span class="tifinagh-mark text-xs" aria-hidden="true">ⵉⵙⴽⴰⵏⵎⴰⴳⴰⵔ</span>
  </div>
</div>
