---
import type { CollectionEntry } from 'astro:content';
import { youtubeThumb } from '@/lib/youtube';

interface Props {
  episode: CollectionEntry<'episodes'>['data'];
}
const { episode } = Astro.props;

const thumb = youtubeThumb(episode.youtubeUrl);
const Wrapper = episode.youtubeUrl ? 'a' : 'div';
---

<Wrapper
  {...episode.youtubeUrl
    ? { href: episode.youtubeUrl, target: '_blank', rel: 'noreferrer' }
    : {}}
  class="panel panel-hover ticks group block p-5"
>
  <div class="relative mb-4 aspect-video overflow-hidden border border-ink-line bg-black">
    {
      thumb ? (
        <img
          src={thumb}
          alt={`Thumbnail for episode ${episode.ep}: ${episode.title}`}
          width="480"
          height="270"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <div class="flex h-full items-center justify-center bg-scanlines text-3xl text-gray-700">▶</div>
      )
    }
    <div class="absolute inset-0 flex items-center justify-center bg-black/30 transition-colors group-hover:bg-black/10">
      <span class="text-4xl text-white/80 drop-shadow transition-transform group-hover:scale-110 group-hover:text-signal">▶</span>
    </div>
    <span class="absolute right-2 top-2 border border-signal/60 bg-ink/90 px-2 py-1 font-mono text-xs font-bold text-signal">
      EP {episode.ep}
    </span>
  </div>

  <h3 class="font-heading text-lg font-bold text-white transition-colors group-hover:text-signal">
    {episode.title}
  </h3>
  {episode.guest && <p class="mt-1 font-mono text-xs text-magenta-bright">{episode.guest}</p>}
  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-gray-400">{episode.description}</p>

  <div class="mt-4 flex items-center justify-between font-mono text-xs text-gray-500">
    <span>{episode.date}</span>
    <span class="border border-ink-line px-2 py-1">{episode.status}</span>
  </div>
</Wrapper>
