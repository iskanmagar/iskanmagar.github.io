---
import { SITE, SOCIAL, NAV } from '@/site.config';
const year = new Date().getFullYear();
---

<footer class="relative z-20 border-t border-signal/20 bg-ink-soft/90 backdrop-blur">
  <div class="mx-auto max-w-7xl px-4 py-12">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr]">
      <!-- Brand -->
      <div>
        <a href="/" class="mb-4 inline-flex items-center gap-3" aria-label="Iskanmagar home">
          <img src="/logo.svg" alt="" class="h-8 w-8 brightness-0 invert" aria-hidden="true" />
          <span class="font-heading text-lg font-bold uppercase tracking-wide text-white">
            Iskanmagar
          </span>
        </a>
        <p class="max-w-sm font-mono text-xs leading-relaxed text-gray-400">
          {SITE.description}
        </p>
        <p class="mt-4 font-mono text-lg tracking-[0.3em] text-signal/80" aria-hidden="true">
          ⵉⵙⴽⴰⵏⵎⴰⴳⴰⵔ
        </p>
      </div>

      <!-- Nav -->
      <nav aria-label="Footer">
        <h2 class="eyebrow mb-4">Channels</h2>
        <ul class="space-y-2 font-mono text-sm">
          {
            NAV.map((item) => (
              <li>
                <a href={item.href} class="text-gray-400 transition-colors hover:text-signal">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Connect -->
      <div>
        <h2 class="eyebrow mb-4">Tune in</h2>
        <ul class="space-y-2 font-mono text-sm">
          <li>
            <a href={SOCIAL.youtube} target="_blank" rel="noreferrer" class="text-gray-400 transition-colors hover:text-signal">
              YouTube ↗
            </a>
          </li>
          <li>
            <a href={SOCIAL.twitter} target="_blank" rel="noreferrer" class="text-gray-400 transition-colors hover:text-signal">
              X / Twitter ↗
            </a>
          </li>
          <li>
            <a href="/rss.xml" class="text-gray-400 transition-colors hover:text-signal">
              RSS Feed ↗
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-ink-line pt-6 font-mono text-xs text-gray-600 sm:flex-row"
    >
      <span class="tracking-[0.3em] text-gray-500" aria-hidden="true">▌▌▌ END OF TRANSMISSION ▌▌▌</span>
      <span>© {year} Iskanmagar Broadcast Network</span>
    </div>
  </div>
</footer>
