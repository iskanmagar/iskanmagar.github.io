---
import { getCollection } from 'astro:content';
import { SOCIAL } from '@/site.config';
import { youtubeThumb } from '@/lib/youtube';

const episodes = (await getCollection('episodes')).sort((a, b) => b.data.order - a.data.order);
const latest = episodes[0];
const latestThumb = youtubeThumb(latest?.data.youtubeUrl);

const tickerItems = [
  'ⵉⵙⴽⴰⵏⵎⴰⴳⴰⵔ',
  'ISKANMAGAR BROADCAST NETWORK',
  latest ? `NOW STREAMING · EP ${latest.data.ep} — ${latest.data.title.toUpperCase()}` : 'STAY TUNED',
  'WHERE WE START IS NOT WHERE WE ARE MEANT TO STOP',
  'A WEAK SIGNAL CAN STILL REACH NEW SKIES',
];
---

<section class="relative">
  <!-- Master control: the station's monitor wall -->
  <div
    class="mx-auto grid max-w-7xl grid-cols-1 gap-5 px-4 pb-16 pt-10 lg:grid-cols-[minmax(0,1.62fr)_minmax(0,1fr)] lg:pt-14"
  >
    <!-- MON 01 · MAIN FEED -->
    <div class="monitor">
      <div class="monitor-label">
        <span>Mon 01 · Main feed</span>
        <span class="flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 animate-blink rounded-full bg-phosphor"></span> Live
        </span>
      </div>
      <div class="monitor-screen crt-on mt-1.5">
        <!-- screen texture -->
        <div class="pointer-events-none absolute inset-0 z-20 bg-scanlines opacity-40"></div>
        <div class="pointer-events-none absolute inset-0 z-20 bg-grain opacity-[0.05] mix-blend-screen"></div>
        <div
          class="pointer-events-none absolute inset-0 z-20 bg-[radial-gradient(115%_115%_at_50%_45%,transparent_60%,rgba(0,0,0,0.5)_100%)]"
        >
        </div>

        <!-- OSD chrome -->
        <div class="absolute left-4 top-4 z-30 flex items-center gap-1 border border-amber/60 bg-amber/10 px-2 py-1 font-mono text-[10px] text-amber">
          <span class="h-1.5 w-1.5 animate-blink rounded-full bg-amber"></span> REC
        </div>
        <div class="absolute right-4 top-4 z-30 border border-phosphor/40 bg-phosphor/10 px-2 py-1 font-mono text-[10px] text-phosphor">
          ON AIR
        </div>
        <div class="absolute bottom-4 left-4 z-30 hidden font-mono text-[10px] tracking-[0.25em] text-gray-500 sm:block">
          ⵉⵙⴽⴰⵏⵎⴰⴳⴰⵔ · CH 01
        </div>
        <div class="absolute bottom-4 right-4 z-30 hidden items-end gap-2 sm:flex">
          <span class="font-mono text-[9px] tracking-widest text-gray-600">SIGNAL</span>
          <div class="meter" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
        </div>

        <!-- The story -->
        <div class="relative z-10 flex flex-col items-center px-6 py-16 text-center sm:px-12 lg:min-h-[560px] lg:justify-center lg:py-20">
          <h1 class="boot boot-1 text-crt font-display text-2xl leading-relaxed text-white sm:text-4xl lg:text-5xl">
            SIGNAL LOST<span class="sr-only">
              — Iskanmagar Broadcast Network: transmissions from underrepresented, multilingual
              builders at the edge of technology, creativity, and community</span
            >
          </h1>
          <p class="boot boot-2 mt-5 font-mono text-xs tracking-signal text-gray-500 sm:text-sm">
            PLEASE STAND BY
          </p>

          <p
            class="boot boot-3 mt-9 inline-flex items-center gap-1 border border-signal/40 bg-ink/80 px-5 py-3 font-mono text-sm text-signal sm:px-6 sm:py-3.5 sm:text-lg"
          >
            <span class="text-gray-600" aria-hidden="true">&gt;&nbsp;</span>iskanmagar init .<span
              class="ml-1 inline-block h-[1.1em] w-[0.55em] animate-blink bg-signal align-text-bottom"
              aria-hidden="true"></span>
          </p>

          <p class="boot boot-4 mt-7 max-w-md text-balance text-base leading-relaxed text-gray-300 sm:text-lg">
            Where we start is not where we are meant to stop.
          </p>

          <div class="boot boot-5 mt-9 flex w-full flex-col items-center justify-center gap-3.5 sm:w-auto sm:flex-row">
            <a href={SOCIAL.youtube} target="_blank" rel="noreferrer" class="btn-signal w-full sm:w-auto">
              ▶ Watch on YouTube
            </a>
            <a href="/episodes" class="btn-ghost w-full sm:w-auto"> Browse episodes </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Side monitors -->
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-1">
      <!-- MON 02 · NOW PLAYING -->
      {
        latest && (
          <a
            href={latest.data.youtubeUrl ?? '/episodes'}
            {...latest.data.youtubeUrl ? { target: '_blank', rel: 'noreferrer' } : {}}
            class="monitor group block transition-colors hover:border-signal/60"
          >
            <div class="monitor-label">
              <span>Mon 02 · Now playing</span>
              <span class="flex items-center gap-1.5 text-phosphor">
                <span class="h-1.5 w-1.5 animate-blink rounded-full bg-phosphor" /> EP {latest.data.ep}
              </span>
            </div>
            <div class="monitor-screen crt-on-2 mt-1.5">
              <div class="relative aspect-video">
                {latestThumb ? (
                  <img
                    src={latestThumb}
                    alt={`Episode ${latest.data.ep}: ${latest.data.title}`}
                    width="480"
                    height="270"
                    loading="eager"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                ) : (
                  <div class="flex h-full items-center justify-center text-3xl text-gray-700">▶</div>
                )}
                <div class="pointer-events-none absolute inset-0 bg-scanlines opacity-40" />
                <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(115%_115%_at_50%_45%,transparent_60%,rgba(0,0,0,0.5)_100%)]" />
                <div class="absolute inset-0 flex items-center justify-center bg-black/25 transition-colors group-hover:bg-black/5">
                  <span class="text-4xl text-white/85 drop-shadow transition-transform group-hover:scale-110 group-hover:text-signal">
                    ▶
                  </span>
                </div>
              </div>
              <div class="border-t border-ink-line bg-ink/90 px-3 py-2.5">
                <p class="truncate font-mono text-[11px] uppercase tracking-wider text-gray-300 transition-colors group-hover:text-signal">
                  EP {latest.data.ep} · {latest.data.title}
                </p>
                {latest.data.guest && <p class="truncate font-mono text-[10px] text-gray-500">{latest.data.guest}</p>}
              </div>
            </div>
          </a>
        )
      }

      <!-- MON 03 · STATION IDENT -->
      <div class="monitor">
        <div class="monitor-label">
          <span>Mon 03 · Station ident</span>
          <span class="text-gray-600">CH 01</span>
        </div>
        <div class="monitor-screen crt-on-3 mt-1.5">
          <div class="relative flex min-h-[190px] flex-col items-center justify-center py-8 lg:min-h-[214px]">
            <div class="pointer-events-none absolute inset-0 bg-scanlines opacity-40"></div>
            <div class="pointer-events-none absolute inset-0 bg-grain opacity-[0.05] mix-blend-screen"></div>
            <!-- SMPTE bars -->
            <div class="absolute inset-x-0 top-0 grid h-9 grid-cols-7">
              <div class="bg-gray-200"></div>
              <div class="bg-amber"></div>
              <div class="bg-signal"></div>
              <div class="bg-phosphor"></div>
              <div class="bg-magenta"></div>
              <div class="bg-red-500"></div>
              <div class="bg-blue-600"></div>
            </div>
            <img
              src="/logo.svg"
              alt=""
              width="72"
              height="72"
              class="relative mt-6 h-16 w-16 brightness-0 invert"
              aria-hidden="true"
            />
            <p class="relative mt-3 font-mono text-sm tracking-[0.3em] text-gray-300">ⵉⵙⴽⴰⵏⵎⴰⴳⴰⵔ</p>
            <p class="relative font-heading text-xs font-bold uppercase tracking-[0.25em] text-white">
              Iskanmagar
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Broadcast ticker -->
  <div class="overflow-hidden border-y border-ink-line bg-ink-soft/70" aria-hidden="true">
    <div class="flex w-max animate-ticker py-3 font-mono text-[11px] tracking-[0.3em] text-gray-500">
      {
        [0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {tickerItems.map((item) => (
              <>
                <span class="whitespace-nowrap px-7">{item}</span>
                <span class="h-1.5 w-1.5 shrink-0 bg-signal/60" />
              </>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
