---
import { getCollection } from 'astro:content';
import { SOCIAL } from '@/site.config';

const episodes = (await getCollection('episodes')).sort((a, b) => b.data.order - a.data.order);
const latest = episodes[0];

const tickerItems = [
  'ISKANMAGAR BROADCAST NETWORK',
  'ⵉⵙⴽⴰⵏⵎⴰⴳⴰⵔ',
  'BROADCASTING FROM THE EDGE',
  latest ? `NOW STREAMING · EP ${latest.data.ep} — ${latest.data.title.toUpperCase()}` : 'STAY TUNED',
  'TALENT IS EVERYWHERE',
  'LEARNING IN PUBLIC',
];
---

<section class="relative">
  <div
    class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-14 px-4 pb-20 pt-14 lg:min-h-[calc(100vh-160px)] lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-10 lg:py-20"
  >
    <!-- Message -->
    <div class="order-1 min-w-0 text-center lg:text-left">
      <p class="eyebrow mb-6 flex-wrap justify-center lg:justify-start">
        Now broadcasting · Channel 01
      </p>
      <h1
        class="text-crt text-balance font-heading text-4xl font-bold leading-[1.05] tracking-tight text-white sm:text-6xl lg:text-[4.4rem]"
      >
        Broadcasting from <span class="text-signal">the edge</span>.
      </h1>
      <p
        class="mx-auto mt-7 max-w-xl text-balance text-lg leading-relaxed text-gray-300 sm:text-xl lg:mx-0"
      >
        Stories, podcasts, and transmissions from underrepresented, multilingual builders creating
        opportunity and learning in public — at the edge of technology, creativity, and community.
      </p>

      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row lg:justify-start">
        <a href={SOCIAL.youtube} target="_blank" rel="noreferrer" class="btn-signal w-full sm:w-auto">
          ▶ Watch on YouTube
        </a>
        <a href="/episodes" class="btn-ghost w-full sm:w-auto"> Browse episodes </a>
      </div>

      {
        latest && (
          <a
            href={latest.data.youtubeUrl ?? '/episodes'}
            {...latest.data.youtubeUrl ? { target: '_blank', rel: 'noreferrer' } : {}}
            class="group mt-10 inline-flex max-w-full items-center gap-3 border border-ink-line bg-ink/70 px-5 py-3 font-mono text-xs text-gray-400 transition-colors hover:border-signal/60"
          >
            <span class="h-2 w-2 flex-none animate-blink rounded-full bg-phosphor" />
            <span class="flex-none text-phosphor">ON AIR</span>
            <span class="flex-none text-ink-line" aria-hidden="true">
              |
            </span>
            <span class="min-w-0 truncate uppercase tracking-wider text-gray-300 transition-colors group-hover:text-signal">
              Now playing: EP {latest.data.ep} · {latest.data.title}
            </span>
            <span class="flex-none text-signal" aria-hidden="true">
              ▶
            </span>
          </a>
        )
      }
    </div>

    <!-- Retro TV set -->
    <div class="order-2 flex min-w-0 justify-center lg:justify-end">
      <div class="relative h-[300px] w-[300px] animate-flicker sm:h-[380px] sm:w-[380px] lg:h-[420px] lg:w-[420px]">
        <div
          class="absolute inset-0 rounded-full border-[12px] border-ink-line bg-black shadow-[0_20px_70px_-10px_rgba(0,0,0,0.9)]"
        >
          <div class="absolute inset-0 overflow-hidden rounded-full border-4 border-ink-line/80 bg-black">
            <!-- CRT curvature vignette -->
            <div
              class="pointer-events-none absolute inset-0 z-20 rounded-full bg-[radial-gradient(circle,transparent_55%,rgba(0,0,0,0.55)_100%)]"
            >
            </div>
            <!-- scanlines + faint static -->
            <div class="pointer-events-none absolute inset-0 z-10 bg-scanlines opacity-40"></div>
            <div class="pointer-events-none absolute inset-0 bg-grain opacity-[0.06] mix-blend-screen"></div>

            <!-- SMPTE color bars -->
            <div class="absolute inset-x-0 top-0 grid h-[26%] grid-cols-7">
              <div class="bg-gray-200"></div>
              <div class="bg-amber"></div>
              <div class="bg-signal"></div>
              <div class="bg-phosphor"></div>
              <div class="bg-magenta"></div>
              <div class="bg-red-500"></div>
              <div class="bg-blue-600"></div>
            </div>

            <!-- Logo -->
            <div class="absolute left-1/2 top-1/2 z-10 -translate-x-1/2 -translate-y-1/2">
              <img
                src="/logo.svg"
                alt="Iskanmagar logo"
                width="112"
                height="112"
                class="h-20 w-20 brightness-0 invert sm:h-28 sm:w-28"
              />
            </div>

            <!-- Bottom OSD -->
            <div class="absolute inset-x-0 bottom-0 flex flex-col items-center pb-5 pt-6">
              <div class="mb-3 flex w-full justify-between px-8 font-mono text-[10px] text-gray-400">
                <span class="flex items-center gap-1 border border-amber/60 bg-amber/10 px-2 py-1 text-amber">
                  <span class="h-1.5 w-1.5 animate-blink rounded-full bg-amber"></span> REC
                </span>
                <span class="border border-phosphor/40 bg-phosphor/10 px-2 py-1 text-phosphor">ON AIR</span>
              </div>
              <p class="font-mono text-sm tracking-[0.3em] text-gray-300">ⵉⵙⴽⴰⵏⵎⴰⴳⴰⵔ</p>
              <p class="font-heading text-sm font-bold uppercase tracking-[0.25em] text-white">Iskanmagar</p>
              <p class="mt-0.5 font-mono text-[9px] tracking-widest text-gray-600">CHANNEL 01 · BROADCAST SIGNAL</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Broadcast ticker -->
  <div class="overflow-hidden border-y border-ink-line bg-ink-soft/70" aria-hidden="true">
    <div class="flex w-max animate-ticker py-3 font-mono text-[11px] tracking-[0.3em] text-gray-500">
      {
        [0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {tickerItems.map((item) => (
              <>
                <span class="whitespace-nowrap px-7">{item}</span>
                <span class="h-1.5 w-1.5 shrink-0 bg-signal/60" />
              </>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
